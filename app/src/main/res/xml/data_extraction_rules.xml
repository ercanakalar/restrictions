<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN and lock state must not be copied to another device or restored from a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
