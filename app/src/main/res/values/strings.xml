<resources>
    <string name="app_name">Family Lock</string>
    <string name="accessibility_description">Shows a full-screen lock during the times a parent has set, and keeps it in place when other apps are opened. Family Lock only looks at which app is on screen. Nothing leaves this phone.</string>
    <string name="admin_explanation">Stops Family Lock from being uninstalled or force-stopped without the parent PIN.</string>
    <string name="admin_disable_warning">Turning this off removes the uninstall protection. The phone is locked until a parent enters the PIN.</string>

    <string name="ok">OK</string>
